# Generated by pipeline/build-react.mjs, which emits each icon's presentation
# attributes on one line. Prettier explodes them onto seven, which is a 3800
# line diff that `npm run icons:react:check` then reports as drift: the file no
# longer matches what the generator would write, so `npm run icons:ci` fails on
# a repo where the only thing anyone did was run `npm run format`. Formatting
# this file is not a style choice the repo gets to make. The generator owns it.
#
# Both targets, for the same reason. The generator writes them byte-identical,
# so formatting one and not the other would put them permanently out of sync
# with each other as well as with the generator.
components/icons/index.tsx
packages/*/src/*.tsx

# Generated by pipeline/build-data.mjs, deliberately minified onto one line so
# the CLI and MCP server parse it once at startup rather than reading 40,000
# pretty-printed ones. Prettier would expand it and `data:check` would then
# report drift.
packages/*/icons.json
# Generated by pipeline/build-history.mjs, minified for the same reason as the
# package data above: it is imported by the page, so every newline in it is
# payload. Prettier would expand it and `history:check` would report drift.
lib/icon-history.json
