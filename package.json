{
  "name": "keyline-icons",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "icons:build": "node pipeline/build.mjs",
    "icons:check": "node pipeline/build.mjs --check",
    "icons:lint": "node pipeline/lint.mjs",
    "history:build": "node pipeline/build-history.mjs",
    "history:check": "node pipeline/build-history.mjs --check",
    "keywords:emit": "node pipeline/build-keywords.mjs --emit",
    "keywords:build": "node pipeline/build-keywords.mjs",
    "keywords:check": "node pipeline/build-keywords.mjs --check",
    "icons:react": "node pipeline/build-react.mjs",
    "icons:react:check": "node pipeline/build-react.mjs --check",
    "brand:build": "node pipeline/build-brand.mjs",
    "brand:check": "node pipeline/build-brand.mjs --check",
    "cover:build": "node pipeline/build-cover.mjs",
    "cover:check": "node pipeline/build-cover.mjs --check",
    "community:build": "node pipeline/build-community.mjs",
    "community:check": "node pipeline/build-community.mjs --check",
    "paper:build": "node pipeline/build-paper.mjs",
    "paper:check": "node pipeline/build-paper.mjs --check",
    "paper:verify": "node pipeline/check-paper.mjs",
    "icons:demos": "node pipeline/check-demos.mjs",
    "readmes:check": "node pipeline/check-readmes.mjs",
    "readmes:fix": "node pipeline/check-readmes.mjs --fix",
    "icons:figma": "node pipeline/check-figma.mjs",
    "icons:ci": "next typegen && node pipeline/build.mjs --check && node pipeline/build-react.mjs --check && node pipeline/build-cover.mjs --check && node pipeline/build-community.mjs --check && node pipeline/build-paper.mjs --check && node pipeline/build-data.mjs --check && node pipeline/lint.mjs && node pipeline/check-demos.mjs && node pipeline/check-readmes.mjs && tsc --noEmit",
    "ship": "node pipeline/ship.mjs",
    "data:build": "node pipeline/build-data.mjs",
    "data:check": "node pipeline/build-data.mjs --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.8.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
