{
  "name": "@keyline-icons/react",
  "version": "0.2.0",
  "description": "Icons on one 24\u00d724 grid, as React components in three weights: stroke, duotone and fill, each in rounded or sharp corners. Built for shadcn/ui.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Keyline Icons (https://keylineicons.com)",
  "homepage": "https://keylineicons.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keyline-icons/keyline-icons.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/keyline-icons/keyline-icons/issues",
  "keywords": [
    "icons",
    "react",
    "svg",
    "shadcn",
    "shadcn-ui",
    "icon-set",
    "tailwind"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./duotone": {
      "types": "./dist/duotone.d.ts",
      "default": "./dist/duotone.js"
    },
    "./fill": {
      "types": "./dist/fill.d.ts",
      "default": "./dist/fill.js"
    },
    "./sharp": {
      "types": "./dist/sharp.d.ts",
      "default": "./dist/sharp.js"
    },
    "./sharp/duotone": {
      "types": "./dist/sharp-duotone.d.ts",
      "default": "./dist/sharp-duotone.js"
    },
    "./sharp/fill": {
      "types": "./dist/sharp-fill.d.ts",
      "default": "./dist/sharp-fill.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json"
  }
}
