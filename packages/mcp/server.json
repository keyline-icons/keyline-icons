{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.keylineicons/mcp",
  "title": "Keyline Icons",
  "description": "Search Keyline Icons by name and get any icon's SVG source or React import. No key, no network.",
  "version": "1.4.0",
  "websiteUrl": "https://keylineicons.com",
  "repository": {
    "url": "https://github.com/keyline-icons/keyline-icons",
    "source": "github",
    "subfolder": "packages/mcp"
  },
  "icons": [
    {
      "src": "https://keylineicons.com/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    },
    {
      "src": "https://keylineicons.com/apple-icon.png",
      "mimeType": "image/png",
      "sizes": ["180x180"]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@keyline-icons/mcp",
      "version": "1.4.0",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
